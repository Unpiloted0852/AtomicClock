<?xml version="1.0" encoding="utf-8"?>
<!-- Outer frame takes the status/navigation bar insets; the inner layout keeps its own margins. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:keepScreenOn="true"
    android:background="@color/bg">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingBottom="16dp">

    <!-- HEADER: title, audio tick, settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp">

        <TextView
            android:text="Atomic Clock"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

        <ImageButton
            android:id="@+id/btnSound"
            android:src="@drawable/ic_sound_off"
            android:contentDescription="Audio tick off"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:layout_width="48dp"
            android:layout_height="48dp"/>

        <ImageButton
            android:id="@+id/btnSettings"
            android:src="@drawable/ic_more"
            android:contentDescription="Settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:layout_marginEnd="-12dp"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
    </LinearLayout>

    <!-- Shown only when GitHub has a newer release; tap to install -->
    <TextView
        android:id="@+id/txtUpdate"
        android:visibility="gone"
        android:text="Update available"
        android:textColor="@color/on_accent_container"
        android:textSize="13sp"
        android:gravity="center"
        android:background="@drawable/bg_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:layout_marginTop="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.5"/>

    <!-- WORLD CLOCKS placed above the main clock (filled in code) -->
    <LinearLayout
        android:id="@+id/worldAbove"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@drawable/bg_card"
        android:paddingVertical="8dp"
        android:layout_marginBottom="28dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- MAIN CLOCK: hh:mm:ss with milliseconds beside it -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/txtTime"
            android:text="--:--:--"
            tools:text="22:36:13"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-light"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtMillis"
            android:text=".---"
            tools:text=".574"
            android:textColor="@color/text_tertiary"
            android:fontFamily="sans-serif-light"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView
        android:id="@+id/txtDate"
        tools:text="Saturday, 14 November"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- SYNC STATUS: dot + text -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/statusDot"
            android:background="@drawable/dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/txtNetworkStats"
            android:text="Connecting to time server…"
            android:textColor="@color/text_tertiary"
            android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- WORLD CLOCKS placed below the main clock (filled in code) -->
    <LinearLayout
        android:id="@+id/worldBelow"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@drawable/bg_card"
        android:paddingVertical="8dp"
        android:layout_marginTop="28dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

    <!-- PHONE CLOCK: how far the phone's own clock is off -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <TextView
                android:text="Phone clock"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/txtOffsetWords"
                android:text="Checking…"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:layout_marginTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtOffset"
            tools:text="+7 ms"
            android:textColor="@color/status_good"
            android:textSize="28sp"
            android:fontFamily="sans-serif-light"
            android:fontFeatureSettings="tnum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- ACTIONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSync"
            style="@style/Widget.Material3.Button.TonalButton"
            android:text="Check again"
            android:textSize="15sp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:layout_marginEnd="6dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetClock"
            style="@style/Widget.Material3.Button"
            android:text="Set phone clock"
            android:textSize="15sp"
            android:layout_width="0dp"
            android:layout_weight="1.3"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

</LinearLayout>
</FrameLayout>
